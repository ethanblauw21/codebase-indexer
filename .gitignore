# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Runtime index artifacts (generated by the indexer). All are rebuildable from
# source by a reindex, so none are ever committed. `.code-index/` matches at any
# depth (the MCP server writes one under src/ when launched from there); the
# `.jina-bak`-style siblings are manual pre-swap snapshots kept while comparing
# embedders (ADR-009 P1), and `.fileSystem-index/` is the fileSystem module's own.
.code-index/
.code-index.*/
.fileSystem-index/
*.faiss
doc_store.json
last_indexed_commit.txt

# SQLite
*.db
*.db-shm
*.db-wal

# Model weights and cache (downloaded at runtime)
.cache/
models/
*.bin
*.safetensors
*.pt

# IDE / Editor
.idea/
.vscode/
*.sublime-*
*.sw?
.DS_Store
Thumbs.db

# Claude Code. `.claude/agents/` IS project configuration (the custom agents this
# repo's workflows depend on) and is tracked. Everything else under .claude/ is
# per-machine session state: local settings, a lock file holding a live pid, the
# regenerated context/ snapshots, and agent-memory/ scratch that churns every run.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/context/
.claude/agent-memory/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Graphify trial artifacts — the tool was removed (ADR-006 builds this natively).
# Keep only the human-readable reports for reference; ignore all machine data/state/cache.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html

# ADR-019 real-repo eval: cloned corpora + built indexes are regenerable from the
# pinned SHAs in benchmarks/real_repo/repos.toml; the private slice (§6) is never
# committed. Only the manifest, the hand-authored fixtures, and the baseline are tracked.
benchmarks/real_repo/corpus/
benchmarks/real_repo/index/
benchmarks/real_repo/private/
benchmarks/real_repo/repos.private.toml
benchmarks/real_repo/fixtures/cleanroom-*.jsonl
benchmarks/real_repo/eval_progress.log

# cloud eval: launcher-generated staging artifacts. last-vm.txt records the most
# recent VM name so the launcher can reattach; it is per-machine scratch, not config.
bundle.tar.gz
cloud/eval-args.txt
cloud/last-vm.txt
eval-args.txt

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Customer control logic (ADR-013 L5X corpus). Live Egan project exports —
# never committed, never read directly, only aggregated by scripts under
# tools/l5x/. Both spellings are listed so a rename cannot silently unprotect it.
Egan_LX_files/
Egan_L5X_files/

# Raw survey output from tools/l5x/ carries customer identifiers verbatim.
# Only the redact_survey.py-reduced form is shareable, and even that is
# regenerable — no survey artifact is committed.
tools/l5x/survey*.json