<?xml version="1.0" encoding="UTF-8"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.05" TargetName="JsrFixture" TargetType="Controller" ContainsContext="false" Owner="conformance-fixture" ExportDate="Mon Aug 03 09:00:00 2026">
<Controller Use="Target" Name="JsrFixture" ProcessorType="1769-L33ER" MajorRev="35" MinorRev="11">
<DataTypes/>
<Tags>
<Tag Name="Fault_Present" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Any active fault on the line]]></Description>
</Tag>
<Tag Name="Line_Running" TagType="Base" DataType="BOOL" Constant="false" ExternalAccess="Read/Write">
<Description><![CDATA[Line is in run state]]></Description>
</Tag>
</Tags>
<Programs>
<Program Name="LineA" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Run the fault handler for this line every scan]]></Comment>
<Text>
<![CDATA[JSR(Faults,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Latch the line fault flag]]></Comment>
<Text>
<![CDATA[XIO(Line_Running)OTE(Fault_Present);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="LineB" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Run this line's own fault handler, which shares a name with LineA's]]></Comment>
<Text>
<![CDATA[JSR(Faults,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Faults" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment><![CDATA[Independent fault logic for the second line]]></Comment>
<Text>
<![CDATA[XIC(Line_Running)OTU(Fault_Present);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500">
<ScheduledPrograms>
<ScheduledProgram Name="LineA"/>
<ScheduledProgram Name="LineB"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
