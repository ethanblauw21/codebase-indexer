    {"source": "MainProgram", "target": "MainProgram.RuntimeTotals", "kind": "owns"},
    {"source": "MainProgram", "target": "MainProgram.Scan_Count", "kind": "owns"},

    {"source": "MainProgram.MainRoutine", "target": "Start_PB", "kind": "reads"},
    {"source": "MainProgram.MainRoutine", "target": "Stop_PB", "kind": "reads"},
    {"source": "MainProgram.MainRoutine", "target": "Motor_Cmd", "kind": "writes"},

    {"source": "MainProgram.MainRoutine", "target": "Motor_Cmd", "kind": "reads"},
    {"source": "MainProgram.MainRoutine", "target": "MainProgram.Scan_Count", "kind": "reads"},
    {"source": "MainProgram.MainRoutine", "target": "MainProgram.Scan_Count", "kind": "writes"},

    {"source": "MainProgram.RuntimeTotals", "target": "Motor_Cmd", "kind": "reads"},
    {"source": "MainProgram.RuntimeTotals", "target": "MainProgram.Scan_Count", "kind": "reads"},
    {"source": "MainProgram.RuntimeTotals", "target": "Run_Seconds", "kind": "writes"}
  ]
