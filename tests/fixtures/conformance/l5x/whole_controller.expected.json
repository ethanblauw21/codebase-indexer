    {"fqn": "MainProgram.MainRoutine", "kind": "routine"},
    {"fqn": "MainProgram.RuntimeTotals", "kind": "routine"},
    {"fqn": "Start_PB", "kind": "tag"},
    {"fqn": "Stop_PB", "kind": "tag"},
    {"fqn": "Motor_Cmd", "kind": "tag"},
    {"fqn": "Run_Seconds", "kind": "tag"},
    {"fqn": "MainProgram.Scan_Count", "kind": "tag"}
  ],
  "edges": [
